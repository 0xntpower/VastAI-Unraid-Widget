&nbsp;
: <input type="submit" value="_(Apply)_">

</form>

<script>
function toggleApiKeyVisibility() {
  const f = document.getElementById('vast_api_key_field');
  const icon = document.getElementById('vast_eye_icon');
  if (f.type === 'password') {
    f.type = 'text';
    icon.className = 'fa fa-eye-slash';
  } else {
    f.type = 'password';
    icon.className = 'fa fa-eye';
  }
}

function testVastConnection() {
  const box = $('#vast_test_box');
  const btn = $('#vast_btn_test');
  const keyField = $('#vast_api_key_field');
  const typedKey = (keyField.val() || '').trim();

  if (!typedKey) {
    box.removeClass('vast-test-success').addClass('vast-test-error').show().html(
      '<strong><i class="fa fa-exclamation-triangle"></i> No API Key Entered:</strong> Please paste your Vast.ai API key into the field above first.'
    );
    return;
  }

  btn.prop('disabled', true).text('Testing…');
  box.removeClass('vast-test-success vast-test-error').show().html('<i class="fa fa-spinner fa-spin"></i> Connecting to Vast.ai API…');

  $.ajax({
    url: '/plugins/vastai/include/getvaststatus.php?force=1',
    type: 'POST',
    data: { test_key: typedKey },
    dataType: 'json',
    timeout: 12000,
    success: function(data) {
      btn.prop('disabled', false).text('Test Connection');
      if (data && data.success) {
        const sum = data.summary || {};
        const count = sum.total_machines || 0;
        const rented = sum.rented_machines || 0;
        box.addClass('vast-test-success').html(
          '<strong><i class="fa fa-check-circle"></i> Connection Successful!</strong><br>' +
          'Found ' + count + ' machine(s) (' + rented + ' currently rented). Total earnings rate: $' + (sum.total_earn_hour || 0).toFixed(3) + '/hr. Account balance: $' + (sum.account_balance || 0).toFixed(2)
        );
      } else {
        box.addClass('vast-test-error').html(
          '<strong><i class="fa fa-times-circle"></i> Connection Failed:</strong> ' + (data.error || 'Unknown error occurred.')
        );
      }
    },
    error: function(xhr, status, err) {
      btn.prop('disabled', false).text('Test Connection');
      box.addClass('vast-test-error').html(
        '<strong><i class="fa fa-times-circle"></i> Request Failed:</strong> ' + status + ' - ' + err
      );
    }
  });
}
</script>
