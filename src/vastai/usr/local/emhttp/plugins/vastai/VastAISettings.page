<script>
function toggleApiKeyVisibility() {
  const f = document.getElementById('vast_api_key_field');
  const icon = document.getElementById('vast_eye_icon');
  if (f.type === 'password') {
    f.type = 'text';
    icon.className = 'fa fa-eye-slash';
  } else {
    f.type = 'password';
    icon.className = 'fa fa-eye';
  }
}

// data.error can carry the Vast.ai API's own message, so never feed it to .html() raw.
function vastEsc(s) {
  return $('<div>').text(s == null ? '' : String(s)).html();
}

function testVastConnection() {
  const box = $('#vast_test_box');
  const btn = $('#vast_btn_test');
  const keyField = $('#vast_api_key_field');
  const typedKey = (keyField.val() || '').trim();

  if (!typedKey) {
    box.removeClass('vast-test-success').addClass('vast-test-error').show().html(
      '<strong><i class="fa fa-exclamation-triangle"></i> No API Key Entered:</strong> Please paste your Vast.ai API key into the field above first.'
    );
    return;
  }

  // Restore the label the page rendered, which may be a translation.
  const label = btn.text();
  btn.prop('disabled', true).text('Testing…');
  box.removeClass('vast-test-success vast-test-error').show().html('<i class="fa fa-spinner fa-spin"></i> Connecting to Vast.ai API…');

  $.ajax({
    url: '/plugins/vastai/include/getvaststatus.php?force=1',
    type: 'POST',
    data: { test_key: typedKey },
    dataType: 'json',
    timeout: 20000,
    success: function(data) {
      btn.prop('disabled', false).text(label);
      if (data && data.success) {
        const sum = data.summary || {};
        const n = function (v) { v = Number(v); return isFinite(v) ? v : 0; };
        // null means the balance is not known: switched off, or the key may not
        // read account info. Saying $0.00 would be a guess.
        const balance = sum.account_balance === null || sum.account_balance === undefined
          ? 'Account balance: not available (it is switched off, or this key cannot read account info).'
          : 'Account balance: $' + n(sum.account_balance).toFixed(2) + '.';
        box.addClass('vast-test-success').html(
          '<strong><i class="fa fa-check-circle"></i> Connection Successful!</strong><br>' +
          'Found ' + n(sum.total_machines) + ' machine(s) (' + n(sum.rented_machines) + ' currently rented). Total earnings rate: $' + n(sum.total_earn_hour).toFixed(3) + '/hr. ' + balance
        );
      } else {
        box.addClass('vast-test-error').html(
          '<strong><i class="fa fa-times-circle"></i> ' + (data && data.code === 'auth' ? 'Key Rejected:' : 'Connection Failed:') + '</strong> ' + vastEsc((data && data.error) || 'Unknown error occurred.')
        );
      }
    },
    error: function(xhr, status, err) {
      btn.prop('disabled', false).text(label);
      box.addClass('vast-test-error').html(
        '<strong><i class="fa fa-times-circle"></i> Request Failed:</strong> ' + vastEsc('this server did not answer (' + status + (err ? ', ' + err : '') + ')')
      );
    }
  });
}
</script>
