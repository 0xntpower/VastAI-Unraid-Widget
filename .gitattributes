# vastai.plg is generated by build/build.ps1 and its bytes must not depend on
# which platform the contributor checked out on. Pin every text file to LF so
# the manifest regenerates identically on Windows, Linux and CI.
* text=auto eol=lf

*.png binary

# Generated. GitHub collapses its diff in a pull request. The scripts it runs as
# root are reviewed where they are readable, in tests/run-blocks.golden.
vastai.plg linguist-generated=true
