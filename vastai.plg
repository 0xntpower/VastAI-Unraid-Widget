<FILE Name="&emhttp;/include/VastAI.php">
<INLINE><![CDATA[<?php
/**
 * Vast.ai Unraid Plugin - dashboard tile shell
 *
 * Registers the empty tile with the dashboard. javascript/vastai.js fills it.
 * The header uses the dashboard's own tile-header classes, which exist from
 * Unraid 7.2.0. That is why the plugin asks for 7.2.0.
 */

global $mytiles;

require_once __DIR__ . '/config.php';

// Empty except under test, see getvaststatus.php.
$root     = PHP_SAPI === 'cli' ? (string) getenv('VASTAI_TEST_ROOT') : '';
$cfg      = vast_config($root);
$interval = $cfg['interval'];

// autov() appends the file's modification time. The browser then keeps both
// files until an update changes them, and a missing file is a visible 404 and
// not a tile that says "Loading" forever.
$asset = fn(string $path): string => function_exists('autov') ? autov($path, true) : $path;
$css   = $asset('/plugins/vastai/styles/vastai.css');
$js    = $asset('/plugins/vastai/javascript/vastai.js');

// The dashboard stores a tile's position, its collapsed state and its closed
// state under md5(title). Translating or renaming the title would reset all
// three for every user, so it is a constant.
$t_title   = 'VAST.AI';
$tr        = function_exists('_');
$t_refresh = $tr ? _('Refresh interval') : 'Refresh interval';
$t_set     = $tr ? _('Vast.ai Settings') : 'Vast.ai Settings';
$t_load    = $tr ? _('Loading Vast.ai status…') : 'Loading Vast.ai status…';

$intOpts = '';
foreach (VAST_INTERVALS as $v) {
    $lab = $v === 0 ? 'off' : ($v < 120 ? "$v s" : ($v / 60) . ' m');
    $sel = $interval === $v ? ' selected' : '';
    $intOpts .= "<option value=\"$v\"$sel>$lab</option>";
}

$mytiles['vastai'][$cfg['column']] = <<<EOT
<tbody title="$t_title" id="vast_tile" data-interval="$interval">
<tr><td>
<link type="text/css" rel="stylesheet" href="$css">
<span class="tile-header">
  <span class="tile-header-left">
    <img src="/plugins/vastai/icons/vastai.png" class="vast-tile-glyph" alt="">
    <span class="vast-tile-title">$t_title</span>
    <span id="vast_subtitle" class="vast-tile-sub">Connecting…</span>
  </span>
  <span class="tile-header-right">
    <span class="tile-header-right-controls vast-header-controls">
      <select id="vast_int" class="auto" title="$t_refresh">$intOpts</select>
      <a href="javascript:void(0)" id="vast_btn_refresh" title="Refresh Now"><i id="vast_refresh_icon" class="fa fa-refresh control"></i></a>
      <a href="/Settings/VastAISettings" title="$t_set"><i class="fa fa-fw fa-cog control"></i></a>
    </span>
  </span>
</span>
</td></tr>
<tr><td>
<div id="vast_widget_container">
  <div class="vast-msg-box grey-text">
    <i class="fa fa-spinner fa-spin vast-msg-spinner"></i> $t_load
  </div>
</div>
<script src="$js"></script>
</td></tr>
</tbody>
EOT;
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/config.php">
<INLINE><![CDATA[<?php
/**
 * Vast.ai Unraid Plugin - settings reader
 *
 * The one place that reads default.cfg and the saved settings and decides what
 * a valid value is. The endpoint, the tile and the settings page all call it,
 * so they cannot disagree about a default or an allowed value.
 */

// Seconds. 0 is "Off". The order is the order the selects show them in.
const VAST_INTERVALS  = [10, 30, 60, 120, 0];
const VAST_CACHE_TTLS = [15, 30, 60, 120];

/**
 * $root is empty except under test, where it points at a scratch directory.
 */
function vast_config(string $root = ''): array {
    $raw = [];
    foreach (["$root/usr/local/emhttp/plugins/vastai/default.cfg",
              "$root/boot/config/plugins/vastai/vastai.cfg"] as $file) {
        // A settings file that does not parse, which one stray quote pasted into
        // the key field is enough to cause, leaves the defaults in place.
        $ini = is_file($file) ? @parse_ini_file($file) : false;
        if (is_array($ini)) {
            $raw = array_merge($raw, $ini);
        }
    }
    $text = fn(string $key, string $default): string
        => is_scalar($raw[$key] ?? null) ? (string) $raw[$key] : $default;
    // Digits only. (int) "abc" is 0, and 0 would silently mean "Off".
    $int  = fn(string $key): int => ctype_digit($text($key, '')) ? (int) $text($key, '') : -1;
    $pick = fn($value, array $allowed, $default) => in_array($value, $allowed, true) ? $value : $default;

    return [
        'api_key'      => trim($text('API_KEY', '')),
        // A value outside the lists is a hand edit. It gets the default, so the
        // tile never polls faster than Settings allows and the select always
        // shows the value in use.
        'interval'     => $pick($int('INTERVAL'), VAST_INTERVALS, 30),
        'cache_ttl'    => $pick($int('CACHE_TTL'), VAST_CACHE_TTLS, 30),
        // Settings no longer offers this, because the dashboard's own saved
        // layout overrides it as soon as any tile is dragged. It is still read
        // so the tile stays where an existing install put it.
        'column'       => $pick($text('COLUMN', ''), ['column1', 'column2', 'column3'], 'column1'),
        'show_balance' => $text('SHOW_BALANCE', '1') !== '0',
    ];
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/getvaststatus.php">
<INLINE><![CDATA[<?php
/**
 * Vast.ai Unraid Plugin - status endpoint
 *
 * Fetches the account's machines and balance from the Vast.ai API, keeps the
 * answer in a private cache, and prints one JSON document. The dashboard tile
 * and the settings page's Test Connection are the two readers. The fields are
 * listed in the README under "Endpoint response".
 */

require_once __DIR__ . '/config.php';

const VAST_MACHINES_URL = 'https://console.vast.ai/api/v0/machines/?owner=me';
const VAST_USER_URL     = 'https://console.vast.ai/api/v0/users/current/';
const VAST_BACKOFF      = 30;               // seconds to wait after a failed fetch
const VAST_BACKOFF_AUTH = 300;              // a rejected key does not heal by itself
const VAST_BALANCE_TTL  = 300;              // the balance changes slowly
const VAST_MAX_BODY     = 8 * 1024 * 1024;  // largest API answer worth reading

function vast_respond(array $body): void {
    // Partial output turns a value JSON cannot hold into 0 or null, so one odd
    // number from the API can never leave the tile with an empty response.
    echo json_encode($body, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR);
    exit;
}

/** A finite float, or 0.0 for anything else (a string, 1e999, null). */
function vast_num($value): float {
    $n = is_numeric($value) ? (float) $value : 0.0;
    return is_finite($n) ? $n : 0.0;
}

if (!function_exists('vast_api_get')) { // tests/prelude.php supplies a canned one
function vast_api_get(string $url, string $api_key, int $timeout = 9): array {
    static $ch = null; // one handle, so the balance call reuses the connection
    $ch ??= curl_init();
    $body = '';
    $too_big = false;
    curl_setopt_array($ch, [
        CURLOPT_URL             => $url,
        CURLOPT_HTTPGET         => true,
        CURLOPT_FOLLOWLOCATION  => true,
        CURLOPT_MAXREDIRS       => 5,
        // A redirect may never downgrade to plain HTTP with the key attached.
        CURLOPT_PROTOCOLS       => CURLPROTO_HTTPS,
        CURLOPT_REDIR_PROTOCOLS => CURLPROTO_HTTPS,
        CURLOPT_CONNECTTIMEOUT  => 5,
        CURLOPT_TIMEOUT         => $timeout,
        CURLOPT_SSL_VERIFYPEER  => true,
        CURLOPT_SSL_VERIFYHOST  => 2,
        CURLOPT_ENCODING        => '', // accept gzip, the API serves it
        CURLOPT_USERAGENT       => 'VastAI-Unraid-Widget/1.0',
        CURLOPT_HTTPHEADER      => [
            'Accept: application/json',
            // A header and not a query parameter, so the key never appears in a
            // URL. libcurl drops it if a redirect leaves the original host.
            'Authorization: Bearer ' . $api_key,
        ],
        // The body arrives here already decompressed, so the cap also bounds
        // what a small compressed answer can expand to.
        CURLOPT_WRITEFUNCTION   => function ($ch, string $chunk) use (&$body, &$too_big): int {
            if (strlen($body) + strlen($chunk) > VAST_MAX_BODY) {
                $too_big = true;
                return 0; // anything but the chunk length aborts the transfer
            }
            $body .= $chunk;
            return strlen($chunk);
        },
    ]);

    $ok = curl_exec($ch);
    return [
        'code'     => (int) curl_getinfo($ch, CURLINFO_HTTP_CODE),
        'errno'    => curl_errno($ch),
        'error'    => $too_big ? 'The Vast.ai API answer was too large to read' : curl_error($ch),
        'response' => $ok ? $body : false,
    ];
}
}

/**
 * The cache directory, or null when it cannot be trusted. Then the request
 * runs without a cache.
 *
 * The cache used to be a file in /tmp, which any local process can write. A
 * planted file was served to the admin's dashboard as if it came from Vast.ai.
 * /var/local is writable by root only, and the directory must also be a real
 * directory, owned by the user this script runs as, closed to everyone else.
 */
function vast_cache_dir(string $root): ?string {
    $dir = "$root/var/local/vastai";
    umask(0077);
    if (!is_dir($dir)) {
        @mkdir($dir, 0700, true);
    }
    $st  = @lstat($dir);
    $uid = function_exists('posix_geteuid') ? posix_geteuid() : 0;
    $private = $st
        && ($st['mode'] & 0170000) === 0040000   // a directory, not a symlink to one
        && ($st['mode'] & 0077) === 0
        && $st['uid'] === $uid;
    return $private ? $dir : null;
}

function vast_read_json(?string $file): ?array {
    if ($file === null || !is_file($file) || is_link($file)) {
        return null;
    }
    $data = json_decode((string) @file_get_contents($file), true);
    return is_array($data) ? $data : null;
}

/** Writes through a temporary file and a rename, so a reader never sees half a file. */
function vast_write_json(string $file, array $data): void {
    $json = json_encode($data, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR);
    $tmp  = $file . '.' . uniqid('tmp', true);
    if ($json === false || @file_put_contents($tmp, $json) === false || !@rename($tmp, $file)) {
        @unlink($tmp);
    }
}

/** The cached API answer for a key, or null when there is none worth using. */
function vast_cache_record(?string $file): ?array {
    $record = vast_read_json($file);
    return $record && is_array($record['machines'] ?? null) && is_int($record['fetched_at'] ?? null)
        ? $record : null;
}

/**
 * One machine as the tile shows it. Every decision about a machine is made
 * here, once: its state, how many GPUs are rented, and its prices per machine.
 */
function vast_machine(array $m): array {
    $text = fn(string $key, string $default = ''): string
        => is_scalar($m[$key] ?? null) ? (string) $m[$key] : $default;
    $num  = fn(string $key): float => vast_num($m[$key] ?? 0);

    $id       = (int) vast_num($m['id'] ?? $m['machine_id'] ?? 0);
    $num_gpus = max(1, (int) $num('num_gpus'));
    $listed   = !empty($m['listed']);

    // timeout is 0 for a machine in contact and grows while it is not. Vast.ai
    // documents none of this. If the field ever goes missing every machine
    // reads as online, which keeps the rental data on screen at the price of
    // no longer noticing an offline host.
    $is_online = $num('timeout') <= 0.0;

    // gpu_occupancy has one letter per GPU, separated by spaces: "D x x x " is
    // a 4-GPU host with one GPU rented. D, R and I mark an on-demand, reserved
    // and interruptible rental and x an idle GPU. The spaces are dropped here,
    // so the string is one character per GPU from this point on. Test for the
    // three letters, never for "not empty", and never compare the whole string
    // with one letter.
    $occupancy = strtoupper(preg_replace('/\s+/', '', $text('gpu_occupancy')));
    $jobs      = max(0, (int) $num('current_rentals_running'));
    $busy      = preg_match_all('/[DRI]/', $occupancy);
    $is_rented = $jobs > 0 || $busy > 0;

    // Offline wins. A host that stopped answering is shown as offline even if
    // a rental is still open on it, and is left out of the rented count and
    // the earnings totals.
    $state = !$is_online ? 'offline' : ($is_rented ? 'rented' : ($listed ? 'listed' : 'unlisted'));

    // How many GPUs are rented, or null when the API did not say: the string
    // is not one character per GPU, or only the rental counter reports a job.
    if ($state !== 'rented') {
        $gpus_rented = 0;
    } elseif ($num_gpus === 1) {
        $gpus_rented = 1;
    } else {
        $gpus_rented = (strlen($occupancy) === $num_gpus && $busy > 0) ? $busy : null;
    }

    $rental_type = null;
    foreach (['D' => 'on_demand', 'R' => 'reserved', 'I' => 'interruptible'] as $letter => $type) {
        if (str_contains($occupancy, $letter)) {
            $rental_type = $type;
            break;
        }
    }

    $cpu_name = preg_replace('/\b(Processor|\d+-Cores?)\b/i', '', $text('cpu_name'));
    $gb       = fn(string $key): float => round($num($key) / 1024, 1);

    // Vast.ai prices a listing per GPU and reports earnings per machine. The
    // tile shows machines, so the two asks are scaled here and nowhere else.
    $gpu_cost = $num('listed_gpu_cost');

    return [
        'id'               => $id,
        'hostname'         => $text('hostname', "Machine #$id"),
        'num_gpus'         => $num_gpus,
        'gpu_name'         => preg_replace('/^NVIDIA\s+/i', '', $text('gpu_name', 'GPU')),
        'gpu_ram_gb'       => $gb('gpu_ram'),
        'gpu_temp'         => is_numeric($m['gpu_max_cur_temp'] ?? null) ? round($num('gpu_max_cur_temp'), 1) : null,
        'reliability'      => is_numeric($m['reliability2'] ?? null) ? round($num('reliability2') * 100, 1) : null,
        'verification'     => $text('verification', 'unverified'),
        'state'            => $state,
        'rental_type'      => $state === 'rented' ? $rental_type : null,
        'gpus_rented'      => $gpus_rented,
        'running_rentals'  => $jobs,
        // Vast.ai reports these as running averages of what the machine really
        // earned, so an idle machine can show a small amount and one that has
        // never been rented a number like 8e-55. Rounding turns that into 0.
        'earn_hour'        => round($num('earn_hour'), 4),
        'earn_day'         => round($num('earn_day'), 4),
        'ask_hour'         => round($gpu_cost * $num_gpus, 4),
        'min_bid_hour'     => round($num('min_bid_price') * $num_gpus, 4),
        'listed_gpu_cost'  => $gpu_cost,
        'cpu_name'         => trim(preg_replace('/\s+/', ' ', $cpu_name)),
        'cpu_cores'        => (int) $num('cpu_cores'),
        'cpu_ram_gb'       => $gb('cpu_ram'),
        'disk_space_gb'    => round($num('disk_space'), 1),
        'avail_disk_gb'    => round($num('avail_disk_space'), 1),
        'inet_down_mbps'   => round($num('inet_down'), 1),
        'inet_up_mbps'     => round($num('inet_up'), 1),
        // The API's own answers, kept for a dashboard tab that was opened
        // before an update and still runs the previous tile script.
        'is_online'        => $is_online,
        'listed'           => $listed,
        'is_rented'        => $is_rented,
        'occupancy_code'   => $occupancy,
        'min_bid_price'    => $num('min_bid_price'),
    ];
}

/**
 * The success response, built from a cache record. A cached answer goes
 * through here again on every request, so nothing that was not cast and
 * checked can reach the browser, whatever the cache file holds.
 */
function vast_payload(array $record, bool $show_balance): array {
    $machines = [];
    $online = $rented = 0;
    $earn_hour = $earn_day = 0.0;
    foreach ($record['machines'] as $raw) {
        if (!is_array($raw)) {
            continue;
        }
        $m = vast_machine($raw);
        $machines[] = $m;
        if ($m['state'] !== 'offline') {
            $online++;
            $earn_hour += $m['earn_hour'];
            $earn_day  += $m['earn_day'];
        }
        if ($m['state'] === 'rented') {
            $rented++;
        }
    }
    $balance = $record['balance'] ?? null;

    return [
        'success'   => true,
        'timestamp' => (int) $record['fetched_at'],
        'summary'   => [
            'total_machines'  => count($machines),
            'online_machines' => $online,
            'rented_machines' => $rented,
            'total_earn_hour' => round($earn_hour, 4),
            'total_earn_day'  => round($earn_day, 4),
            // null means not known: switched off, or the balance call failed.
            // It is never reported as 0.
            'account_balance' => $show_balance && is_numeric($balance) ? round(vast_num($balance), 2) : null,
        ],
        'machines'  => $machines,
    ];
}

/** Cached data served in place of a fetch that failed. */
function vast_stale(array $record, bool $show_balance, string $error): array {
    return vast_payload($record, $show_balance) + [
        'stale'     => true,
        'cache_age' => max(0, time() - $record['fetched_at']),
        'warning'   => "Vast.ai API error ($error). Showing cached data.",
    ];
}

// ---------------------------------------------------------------- request

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-cache, no-store, must-revalidate');

// Tests run this script under the CLI with VASTAI_TEST_ROOT set to a scratch
// directory. Over HTTP the SAPI is fpm-fcgi, so the prefix is always empty.
$root    = PHP_SAPI === 'cli' ? (string) getenv('VASTAI_TEST_ROOT') : '';
$cfg     = vast_config($root);
$api_key = $cfg['api_key'];
$show    = $cfg['show_balance'];
$force   = in_array($_GET['force'] ?? '', ['1', 'true'], true);

// test_key is read from POST only. Unraid checks the CSRF token on POST and on
// nothing else, so a key accepted over GET would be the one request in this
// plugin that another site could make on the admin's behalf.
$is_test = false;
if (is_string($_POST['test_key'] ?? null) && trim($_POST['test_key']) !== '') {
    $api_key = trim($_POST['test_key']);
    $is_test = true;
}

if ($api_key === '') {
    vast_respond([
        'success'   => false,
        'code'      => 'not_configured',
        'error'     => 'Vast.ai API Key is not configured. Please open Settings → Utilities → Vast.ai Monitor to enter your API key.',
        'timestamp' => time(),
    ]);
}

// One cache per key, so a changed key can never show the previous account's
// machines. A Test Connection request has no cache at all: it reads nothing
// cached and leaves nothing behind for the dashboard to pick up.
$dir          = $is_test ? null : vast_cache_dir($root);
$base         = $dir === null ? null : "$dir/cache_" . substr(hash('sha256', $api_key), 0, 16);
$cache_file   = $base === null ? null : "$base.json";
$backoff_file = $base === null ? null : "$base.backoff";

// What can be answered without calling Vast.ai: a cache younger than the TTL,
// or, for a while after a failed fetch, the old data or the recorded error.
$from_cache = function () use ($cache_file, $backoff_file, $cfg, $show): ?array {
    $record = vast_cache_record($cache_file);
    $age    = $record ? time() - $record['fetched_at'] : -1;
    if ($age >= 0 && $age < $cfg['cache_ttl']) {
        return vast_payload($record, $show) + ['cached' => true, 'cache_age' => $age];
    }
    $failure = vast_read_json($backoff_file);
    $since   = $failure ? time() - (int) ($failure['timestamp'] ?? 0) : -1;
    $window  = ($failure['code'] ?? '') === 'auth' ? VAST_BACKOFF_AUTH : VAST_BACKOFF;
    if ($since >= 0 && $since < $window) {
        return $record ? vast_stale($record, $show, (string) ($failure['error'] ?? 'unreachable')) : $failure;
    }
    return null;
};

if (!$force && ($hit = $from_cache())) {
    vast_respond($hit);
}

// One request per key talks to Vast.ai at a time. The lock is released when
// the script ends, so no exit path has to unlock it.
$lock   = $base === null ? null : @fopen("$base.lock", 'c');
$waited = false;
if ($lock && !flock($lock, LOCK_EX | LOCK_NB)) {
    // Another request is fetching this key. Old data is good enough for one
    // poll. With nothing to show yet, wait for that request to finish.
    if (!$force && ($record = vast_cache_record($cache_file))) {
        vast_respond(vast_payload($record, $show) + ['cached' => true, 'cache_age' => max(0, time() - $record['fetched_at'])]);
    }
    flock($lock, LOCK_EX);
    $waited = true;
}
// The request that held the lock left a cache or a recorded failure behind.
if ($lock && ($waited || !$force) && ($hit = $from_cache())) {
    vast_respond($hit);
}

// 1. Machines
$started = time();
$res     = vast_api_get(VAST_MACHINES_URL, $api_key);
$data    = json_decode((string) $res['response'], true);
// A 200 whose body is not machine data (a CDN error page, a captive portal) is
// a failure too. Taking it for an empty fleet would replace the last good data.
$ok = $res['errno'] === 0 && $res['code'] === 200
    && is_array($data) && is_array($data['machines'] ?? null);

if (!$ok) {
    $code = $res['code'];
    // Vast.ai answers a missing key with 403 and an invalid one with 404
    // "Invalid user key". Only a complete answer counts: a transfer that broke
    // off says nothing about the key.
    $auth    = $res['errno'] === 0 && in_array($code, [401, 403, 404], true);
    $api_msg = is_array($data) && is_scalar($data['msg'] ?? $data['error'] ?? null)
        ? (string) ($data['msg'] ?? $data['error']) : '';

    if ($res['error'] !== '') {
        $error = $res['error'];
    } elseif ($api_msg !== '') {
        $error = "$api_msg (HTTP $code)";
    } elseif ($auth) {
        $error = "Invalid API Key or unauthorized (HTTP $code). Please verify your key from console.vast.ai/manage-keys.";
    } elseif ($code === 200) {
        $error = 'Unexpected response from the Vast.ai API (HTTP 200, not machine data)';
    } else {
        $error = "HTTP $code";
    }
    $error = trim(preg_replace('/[\x00-\x1f\x7f]+/', ' ', $error));

    $failure = [
        'success'   => false,
        // "auth" means the key has to change. "upstream" means wait.
        'code'      => $auth ? 'auth' : 'upstream',
        'error'     => $error,
        'http_code' => $code,
        'timestamp' => time(),
    ];

    if ($backoff_file !== null) {
        // Logged when a failure starts or changes, not on every poll.
        if ((vast_read_json($backoff_file)['error'] ?? null) !== $error) {
            syslog(LOG_WARNING, "vastai: $error");
        }
        // The next requests replay this file for the backoff window and do not
        // call Vast.ai again, whether or not there is cached data to show.
        vast_write_json($backoff_file, $failure);

        if ($auth) {
            // A rejected key is not an outage. Showing its old data as STALE
            // would hide the real problem for as long as the key stays revoked.
            @unlink($cache_file);
        } elseif ($record = vast_cache_record($cache_file)) {
            vast_respond(vast_stale($record, $show, $error));
        }
    }
    vast_respond($failure);
}

// 2. Balance. A failure here only leaves the balance unknown. The last value
//    is reused for a few minutes, so most refreshes are one API call, not two.
$balance    = null;
$balance_at = 0;
if ($show) {
    $previous = $force ? null : vast_cache_record($cache_file);
    $since    = $previous ? time() - (int) ($previous['balance_at'] ?? 0) : -1;
    if ($since >= 0 && $since < VAST_BALANCE_TTL && is_numeric($previous['balance'] ?? null)) {
        $balance    = vast_num($previous['balance']);
        $balance_at = (int) $previous['balance_at'];
    } else {
        $user_res = vast_api_get(VAST_USER_URL, $api_key, 5);
        $user     = $user_res['code'] === 200 ? json_decode((string) $user_res['response'], true) : null;
        if (is_array($user) && is_numeric($user['balance'] ?? null)) {
            $balance    = vast_num($user['balance']);
            $balance_at = time();
        }
    }
}

// 3. Keep what the API said, then answer from it. The age of a cache counts
//    from when its fetch started, so a refresh interval equal to the cache TTL
//    gets new data on every poll and not on every second one.
$record = [
    'fetched_at' => $started,
    'balance'    => $balance,
    'balance_at' => $balance_at,
    'machines'   => $data['machines'],
];
if ($cache_file !== null) {
    vast_write_json($cache_file, $record);
    @unlink($backoff_file);
}

vast_respond(vast_payload($record, $show));
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/javascript/vastai.js">
<INLINE><![CDATA[/**
 * Vast.ai Unraid Plugin - dashboard tile
 *
 * Polls the plugin's endpoint and draws its answer as a table in the tile.
 * The endpoint decides what state a machine is in and what it costs. This file
 * only draws that, so the two cannot disagree.
 */

(function () {
  'use strict';

  const ENDPOINT = '/plugins/vastai/include/getvaststatus.php';

  let pollTimer = null;
  let isFetching = false;
  let showHardwareDetails = false;
  let lastData = null;
  let lastRenderKey = null;

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Every number the endpoint sends goes through here before it is printed, so
  // a field of the wrong type can never reach the page as markup.
  function num(v) {
    const n = Number(v);
    return Number.isFinite(n) ? n : 0;
  }

  function formatMoney(amount, decimals = 2) {
    return '$' + num(amount).toFixed(decimals);
  }

  function formatRate(amount) {
    const n = num(amount);
    if (n < 0.00005) return '$0.00/hr';
    if (n < 0.01) return '$' + n.toFixed(4) + '/hr';
    return '$' + n.toFixed(3) + '/hr';
  }

  function formatAge(seconds) {
    const s = num(seconds);
    if (s < 90) return `${Math.round(s)}s`;
    if (s < 5400) return `${Math.round(s / 60)}m`;
    return `${Math.round(s / 3600)}h`;
  }

  // The text colours are Unraid's own classes, which read on light and dark
  // themes alike. state: [colour, label, line under the label, bar fill]
  const STATES = {
    offline:  ['red-text',   'offline',  'Unreachable',    'fill-gray'],
    rented:   ['green-text', 'active',   'Active',         'fill-green'],
    listed:   ['blue-text',  'listed',   'Ready for rent', 'fill-blue'],
    unlisted: ['grey-text',  'unlisted', 'Not listed',     'fill-gray'],
  };
  const RENTAL = { on_demand: 'On-Demand', reserved: 'Reserved', interruptible: 'Interruptible' };

  function renderMachineRow(m) {
    const state = STATES[m.state] ? m.state : 'unlisted';
    const [colour, label, idleSub, stateFill] = STATES[state];
    const rented = state === 'rented';
    const gpus = num(m.num_gpus) || 1;
    // null when the API did not say how many of the GPUs are rented.
    const busy = m.gpus_rented === null || m.gpus_rented === undefined ? null : num(m.gpus_rented);

    // Status
    let sub = idleSub;
    if (rented) {
      // Print a job count only when the API gave one.
      const jobs = num(m.running_rentals);
      sub = (RENTAL[m.rental_type] || 'Active') + (jobs > 0 ? ` • ${jobs} ${jobs === 1 ? 'job' : 'jobs'}` : '');
    }
    const statusHtml = `
      <span class="vast-status-indicator ${colour}"><span class="vast-status-dot"></span> ${label}</span>
      <div class="vast-status-sub">${sub}</div>
    `;

    // Rate. Always per machine: what it earns when rented, what it asks when listed.
    let rateHtml = `
      <span class="vast-rate-val vast-dim">$0.00/hr</span>
      <div class="vast-rate-sub">-</div>
    `;
    if (rented) {
      // On a partly rented host the other GPUs are still for rent.
      const ask = m.listed && busy !== null && busy < gpus && num(m.listed_gpu_cost) > 0
        ? ` &middot; ask ${formatRate(m.listed_gpu_cost)}/GPU` : '';
      rateHtml = `
        <span class="vast-rate-val green-text">+${formatRate(m.earn_hour)}</span>
        <div class="vast-rate-sub">Est. ${formatMoney(m.earn_day)}/day${ask}</div>
      `;
    } else if (state === 'listed') {
      rateHtml = `
        <span class="vast-rate-val">${formatRate(m.ask_hour)}</span>
        <div class="vast-rate-sub">Min: ${formatRate(m.min_bid_hour)}${gpus > 1 ? ` &middot; ${formatRate(m.listed_gpu_cost)}/GPU` : ''}</div>
      `;
    }

    // Temperature
    let tempHtml = '-';
    if (m.gpu_temp !== null && m.gpu_temp !== undefined) {
      const temp = num(m.gpu_temp);
      const tempClass = temp >= 80 ? 'red-text vast-temp-hot' : temp >= 65 ? 'orange-text' : 'green-text';
      tempHtml = `<span class="${tempClass}">${temp} °C</span>`;
    }

    // Reliability
    let reliabHtml = '-';
    if (m.reliability !== null && m.reliability !== undefined) {
      const rel = num(m.reliability);
      reliabHtml = rel >= 95
        ? `<span class="vast-smart green-text"><i class="fa fa-check"></i> ${rel}%</span>`
        : `<span class="vast-smart orange-text"><i class="fa fa-exclamation-triangle"></i> ${rel}%</span>`;
    }

    // Utilization: the share of this machine's GPUs that are rented. With an
    // unknown split the bar is filled, because something is rented, but no
    // number is printed.
    let utilPercent = 0;
    let utilText = '0%';
    let fill = stateFill;
    if (rented) {
      utilPercent = busy === null ? 100 : Math.min(100, Math.round(100 * busy / gpus));
      utilText = busy === null ? '&ndash;' : `${utilPercent}%`;
      if (m.rental_type === 'interruptible') fill = 'fill-amber';
    }
    const utilTitle = rented && busy === null ? ' title="Rented. The API did not report how many GPUs."' : '';
    const utilHtml = `
      <span class="vast-util-text"${utilTitle}>${utilText}</span>
      <div class="vast-util-bar">
        <div class="vast-util-fill ${fill}" style="width: ${utilPercent}%;"></div>
      </div>
    `;

    const ram = num(m.gpu_ram_gb);
    let html = `
      <tr class="vast-row">
        <td class="vast-col-device">
          <div class="vast-dev-name">
            <i class="fa fa-desktop vast-icon-host"></i>
            <span>${escapeHtml(m.hostname)}</span>
          </div>
          <div class="vast-dev-sub">#${escapeHtml(m.id)} • ${gpus}x ${escapeHtml(m.gpu_name)} ${ram ? `(${ram} GB)` : ''}</div>
        </td>
        <td class="vast-col-status">${statusHtml}</td>
        <td class="vast-col-rate">${rateHtml}</td>
        <td class="vast-col-temp">${tempHtml}</td>
        <td class="vast-col-smart">${reliabHtml}</td>
        <td class="vast-col-util">${utilHtml}</td>
      </tr>
    `;

    if (showHardwareDetails) {
      const details = [];
      const item = (icon, text) => details.push(`<div class="vast-details-item"><i class="fa ${icon}"></i> ${text}</div>`);
      if (m.cpu_name) {
        item('fa-server', `CPU: <strong>${escapeHtml(m.cpu_name)}${num(m.cpu_cores) ? ` (${num(m.cpu_cores)}C)` : ''}</strong>`);
      }
      if (num(m.cpu_ram_gb)) {
        item('fa-microchip', `RAM: <strong>${num(m.cpu_ram_gb)} GB</strong>`);
      }
      if (num(m.disk_space_gb)) {
        item('fa-hdd-o', `Disk: <strong>${num(m.disk_space_gb)} GB (${num(m.avail_disk_gb)} GB Free)</strong>`);
      }
      if (num(m.inet_down_mbps) && num(m.inet_up_mbps)) {
        item('fa-exchange', `Net: <strong>${num(m.inet_down_mbps)} ↓ / ${num(m.inet_up_mbps)} ↑ Mbps</strong>`);
      }
      if (m.verification) {
        item('fa-shield', `Verification: <strong>${escapeHtml(m.verification)}</strong>`);
      }
      html += `
        <tr class="vast-details-row">
          <td colspan="6">
            <div class="vast-details-grid">${details.join('')}</div>
          </td>
        </tr>
      `;
    }

    return html;
  }

  function renderTile(data) {
    const sum = data.summary || {};
    const machines = Array.isArray(data.machines) ? data.machines : [];
    const total = num(sum.total_machines);
    const online = sum.online_machines === undefined ? total : num(sum.online_machines);

    // The header says whether the hosts are online. That the API answered is
    // not the same thing, and stale data is never called online.
    let hosts = `${online}/${total} ONLINE`;
    if (online === total) hosts = 'ONLINE';
    else if (online === 0) hosts = 'OFFLINE';
    const rented = `${num(sum.rented_machines)} of ${total} Rented`;
    const $subtitle = $('#vast_subtitle');
    if (total === 0) {
      $subtitle.text('No machines');
    } else if (data.stale) {
      $subtitle.html(`<span class="vast-stale orange-text">Status: STALE</span> • ${rented} • data ${formatAge(data.cache_age)} old`);
    } else if (data.cached && num(data.cache_age) > 0) {
      $subtitle.html(`Status: ${hosts} • ${rented} • cached ${num(data.cache_age)}s ago`);
    } else {
      $subtitle.html(`Status: ${hosts} • ${rented}`);
    }

    // Most polls return the data that is already on screen. Leaving the table
    // alone keeps a text selection or a hover alive between polls.
    const key = [data.timestamp, showHardwareDetails, data.warning || '', machines.length].join('|');
    if (key === lastRenderKey) return;
    lastRenderKey = key;

    const $container = $('#vast_widget_container');
    const warning = data.warning ? `<div class="vast-msg-box vast-warn orange-text">${escapeHtml(data.warning)}</div>` : '';
    if (machines.length === 0) {
      $container.html(`
        ${warning}
        <div class="vast-msg-box grey-text">
          <i class="fa fa-server vast-msg-icon"></i>
          No host machines found on this Vast.ai account.
        </div>
      `);
      return;
    }

    const earn = num(sum.total_earn_hour);
    const earnSummary = earn >= 0.00005
      ? `Total Earnings: <strong><span class="green-text">+${formatRate(earn)}</span></strong> (Est. ${formatMoney(sum.total_earn_day)}/day)`
      : 'Total Earnings: <strong>$0.00/hr</strong> (Idle)';
    // null means the balance is not known. It is hidden, never shown as $0.00.
    const known = sum.account_balance !== null && sum.account_balance !== undefined;
    const balanceText = known ? ` | Balance: <strong>${formatMoney(sum.account_balance)}</strong>` : '';

    $container.html(`
      ${warning}
      <div class="vast-summary-line">
        <div>${earnSummary}${balanceText}</div>
        <div><a class="vast-toggle-details" data-vast="details">${showHardwareDetails ? 'Hide details' : 'Show details'}</a></div>
      </div>
      <table class="vast-table">
        <thead>
          <tr>
            <th class="vast-col-device">DEVICE</th>
            <th class="vast-col-status">STATUS</th>
            <th class="vast-col-rate">RATE</th>
            <th class="vast-col-temp">TEMP</th>
            <th class="vast-col-smart">RELIABILITY</th>
            <th class="vast-col-util" title="Share of this machine's GPUs that are rented">UTILIZATION</th>
          </tr>
        </thead>
        <tbody>${machines.map(renderMachineRow).join('')}</tbody>
      </table>
    `);
  }

  // Replaces the table with a message. `link` is [text, href or data-vast action].
  function showMessage(subtitle, icon, colour, text, link) {
    lastRenderKey = null;
    $('#vast_subtitle').text(subtitle);
    const attr = link && link[1].startsWith('/') ? `href="${link[1]}"` : `data-vast="${link ? link[1] : ''}"`;
    $('#vast_widget_container').html(`
      <div class="vast-msg-box ${colour}">
        <i class="fa ${icon} vast-msg-icon"></i>
        ${escapeHtml(text)}
        ${link ? `<br><br><a ${attr}>${link[0]}</a>` : ''}
      </div>
    `);
  }

  const SETTINGS = ['Go to Vast.ai Settings', '/Settings/VastAISettings'];

  function refresh(force) {
    if (isFetching) return;
    isFetching = true;
    const $icon = $('#vast_refresh_icon');
    $icon.addClass('spinning');

    $.ajax({
      url: ENDPOINT + (force ? '?force=1' : ''),
      type: 'GET',
      dataType: 'json',
      cache: false,
      // Above the backend's worst case (9 s machines + 5 s balance), so a slow
      // API reads as slow and not as the local service being down.
      timeout: 20000,
      success: function (data) {
        $icon.removeClass('spinning');
        isFetching = false;

        if (data && data.success) {
          lastData = data;
          renderTile(data);
        } else if (data && data.code === 'not_configured') {
          // Nothing changes until the user saves a key, which is a page load.
          setupPolling(0);
          showMessage('Not Configured', 'fa-key', 'blue-text', data.error || 'Please configure your Vast.ai API Key.', SETTINGS);
        } else if (data && data.code === 'auth') {
          // Retrying cannot fix a rejected key. Changing it can.
          showMessage('API Key Rejected', 'fa-key', 'red-text', data.error, SETTINGS);
        } else {
          showMessage('Vast.ai Unreachable', 'fa-exclamation-triangle', 'red-text',
            data && data.error ? data.error : 'Failed to connect to Vast.ai API.', ['Retry', 'retry']);
        }
      },
      error: function (xhr, status) {
        $icon.removeClass('spinning');
        isFetching = false;
        if (status === 'parsererror') {
          // The login page came back in place of JSON: the session ended, or
          // the server restarted. Polling cannot recover from that.
          setupPolling(0);
          showMessage('Signed Out', 'fa-sign-in', 'red-text', 'The Unraid session has ended. Reload the page to sign in again.');
        } else {
          showMessage('Error', 'fa-plug', 'red-text', `Failed to reach the plugin on this server (${status}).`, ['Retry', 'retry']);
        }
      }
    });
  }

  function setupPolling(intervalSec) {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
    const sec = parseInt(intervalSec, 10);
    if (!isNaN(sec) && sec > 0) {
      pollTimer = setInterval(function () {
        // A hidden tab and a closed tile have nobody to show new data to.
        if (!document.hidden && $('#vast_tile').is(':visible')) refresh(false);
      }, sec * 1000);
    }
  }

  $(function () {
    const $tile = $('#vast_tile');
    if (!$tile.length) return;

    $('#vast_int').on('change', function () {
      setupPolling($(this).val());
    });

    $('#vast_btn_refresh').on('click', function (e) {
      e.preventDefault();
      refresh(true);
    });

    // One handler for the links the tile draws inside its body.
    $('#vast_widget_container').on('click', '[data-vast]', function (e) {
      e.preventDefault();
      if (this.getAttribute('data-vast') === 'retry') {
        refresh(true);
      } else if (lastData) {
        // Showing details is local state. Redraw what is already here.
        showHardwareDetails = !showHardwareDetails;
        renderTile(lastData);
      }
    });

    // Coming back to the tab, or waking the laptop, should not leave old data
    // on screen until the next tick.
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && pollTimer) refresh(false);
    });

    // ?? not ||: 0 is the "Off" setting and must stay 0.
    setupPolling($tile.data('interval') ?? 30);
    refresh(false);
  });
})();
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/styles/vastai.css">
<INLINE><![CDATA[/**
 * Vast.ai Unraid Plugin - dashboard tile styles
 *
 * Text colours come from Unraid's theme variables (defined from 7.1.0) and from
 * its green-text, orange-text, red-text, blue-text and grey-text classes, which
 * the tile script puts on the elements. Nothing here names a text colour of its
 * own, so the tile follows every theme, light or dark.
 */

/* Header & Controls */
.vast-tile-glyph {
  width: 20px;
  height: 20px;
  margin-right: 8px;
  vertical-align: middle;
  border-radius: 4px;
  flex: 0 0 auto;
}

.vast-tile-title {
  display: inline-block;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-color);
  margin: 0;
  vertical-align: middle;
}

.vast-tile-sub {
  font-size: 12px;
  font-weight: normal;
  color: var(--alt-text-color);
  margin-left: 10px;
  vertical-align: middle;
}

.vast-header-controls {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.vast-header-controls select.auto {
  font-size: 11px;
  padding: 1px 4px;
  height: 22px;
  border-radius: 3px;
  background: var(--mild-background-color, transparent);
  color: var(--text-color);
  border: 1px solid var(--border-color, rgba(128, 128, 128, 0.3));
  cursor: pointer;
}

.vast-header-controls i.control {
  font-size: 13px;
  color: var(--alt-text-color);
  cursor: pointer;
  transition: color 0.15s ease;
}

.vast-header-controls i.control:hover {
  color: var(--text-color);
}

.vast-header-controls i.spinning {
  animation: vast-spin 0.8s linear infinite;
}

@keyframes vast-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Sub-header Summary Bar (e.g. Total Power / Array TB style) */
.vast-summary-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 0 8px 0;
  font-size: 12px;
  color: var(--alt-text-color);
  border-bottom: 1px solid var(--border-color, rgba(128, 128, 128, 0.3));
  margin-bottom: 6px;
}

.vast-summary-line strong {
  color: var(--text-color);
}

.vast-toggle-details {
  color: var(--link-text-color);
  cursor: pointer;
  font-size: 11px;
  text-decoration: none;
  user-select: none;
}

.vast-toggle-details:hover {
  text-decoration: underline;
}

/* Native Unraid Table */
table.vast-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  line-height: 1.4;
  color: var(--text-color);
}

table.vast-table thead th {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--alt-text-color);
  text-align: left;
  padding: 4px 8px;
  border: none;
  border-bottom: 1px solid var(--border-color, rgba(128, 128, 128, 0.3));
  white-space: nowrap;
}

table.vast-table tbody tr.vast-row {
  border-bottom: 1px solid var(--border-color, rgba(128, 128, 128, 0.3));
  transition: background-color 0.15s ease;
}

table.vast-table tbody tr.vast-row:hover {
  background-color: rgba(128, 128, 128, 0.05);
}

table.vast-table tbody td {
  padding: 7px 8px;
  vertical-align: middle;
}

/* Column 1: Machine / Device */
.vast-col-device {
  min-width: 130px;
}

.vast-dev-name {
  display: flex;
  align-items: center;
  gap: 7px;
  font-weight: 600;
  color: var(--text-color);
}

.vast-dev-name i.vast-icon-host {
  font-size: 14px;
  color: var(--alt-text-color);
  width: 16px;
  text-align: center;
}

.vast-dev-sub {
  font-size: 11px;
  color: var(--alt-text-color);
  margin-left: 23px;
  margin-top: 1px;
}

/* Column 2: Status */
.vast-col-status {
  white-space: nowrap;
}

.vast-status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 500;
}

.vast-status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.vast-status-sub {
  font-size: 10.5px;
  color: var(--alt-text-color);
  margin-left: 12px;
  margin-top: 1px;
}

/* Column 3: Rate */
.vast-col-rate {
  white-space: nowrap;
}

.vast-rate-val {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.vast-dim {
  opacity: 0.6;
}

.vast-rate-sub {
  font-size: 10.5px;
  color: var(--alt-text-color);
}

/* Column 4: Temp */
.vast-col-temp {
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.vast-temp-hot { font-weight: 700; }

/* Column 5: Reliability / Health */
.vast-col-smart {
  white-space: nowrap;
}

.vast-smart {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

/* Column 6: Utilization / Occupancy Bar */
.vast-col-util {
  min-width: 100px;
  white-space: nowrap;
}

.vast-util-text {
  font-variant-numeric: tabular-nums;
  display: inline-block;
  width: 34px;
  text-align: right;
  margin-right: 6px;
  font-size: 11.5px;
  color: var(--text-color);
}

.vast-util-bar {
  display: inline-block;
  width: 60px;
  height: 8px;
  background-color: var(--border-color, rgba(128, 128, 128, 0.3));
  border-radius: 0;
  overflow: hidden;
  vertical-align: middle;
}

/* The bar fills are backgrounds, not text, so they keep fixed colours. */
.vast-util-fill {
  height: 100%;
}

.vast-util-fill.fill-green { background-color: #4cd964; }
.vast-util-fill.fill-amber { background-color: #ff9500; }
.vast-util-fill.fill-blue  { background-color: #38bdf8; }
.vast-util-fill.fill-gray  { background-color: #555555; }

/* Expandable Hardware Details Sub-row */
tr.vast-details-row td {
  background: rgba(0, 0, 0, 0.15);
  padding: 6px 12px 10px 12px;
  border-bottom: 1px solid var(--border-color, rgba(128, 128, 128, 0.3));
}

.vast-details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 6px 16px;
  font-size: 11px;
  color: var(--alt-text-color);
}

.vast-details-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.vast-details-item i {
  width: 14px;
  opacity: 0.7;
}

.vast-details-item strong {
  color: var(--text-color);
}

/* Empty & Error Messages */
/* No colour here. This stylesheet loads after Unraid's, so a colour on the box
   would beat the grey-text, red-text or orange-text class the script gives it. */
.vast-msg-box {
  padding: 16px;
  text-align: center;
  font-size: 12px;
}

.vast-msg-box a {
  color: var(--link-text-color);
  text-decoration: underline;
  cursor: pointer;
}

.vast-msg-icon {
  display: block;
  font-size: 20px;
  margin-bottom: 6px;
  opacity: 0.8;
}

.vast-msg-spinner {
  font-size: 16px;
  margin-right: 6px;
}

.vast-stale {
  font-weight: 600;
}

.vast-warn {
  border: 1px solid currentColor;
  border-radius: 4px;
  margin-bottom: 8px;
}
]]></INLINE>
</FILE>

<!-- Post-install notification -->
<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo " &name; has been installed successfully!           "
echo " Version: &version;                                 "
echo "----------------------------------------------------"
echo " Next step: Navigate to Settings -> Utilities ->   "
echo " Vast.ai Monitor to enter your Vast.ai API Key.     "
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Removal script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing &name;..."
rm -rf &emhttp;
rm -rf &cache;
rm -f &oldcache;*
if [ -f &plugin;/&name;.cfg ]; then
  sed -i 's|^API_KEY=.*|API_KEY=""|' &plugin;/&name;.cfg
  echo "Vast.ai API key blanked in &plugin;/&name;.cfg"
  echo "Copies may remain in flash backups. Delete the key at https://console.vast.ai/manage-keys/"
fi
echo "&name; has been removed."
</INLINE>
</FILE>

</PLUGIN>