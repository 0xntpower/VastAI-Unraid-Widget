    <option value="column1" <?=$column==='column1'?'selected':''?>>_(Left Column)_</option>
    <option value="column2" <?=$column==='column2'?'selected':''?>>_(Middle Column)_</option>
    <option value="column3" <?=$column==='column3'?'selected':''?>>_(Right Column)_</option>
  </select>

_(Show Account Balance)_:
