    <?php endforeach; ?>
  </select>
  <span style="font-size: 0.85rem; opacity: 0.75;">_(How often an open dashboard asks this server for data. A dashboard in a background tab and a closed tile do not ask.)_</span>

_(Local Cache Expiration)_:
: <select name="CACHE_TTL">
    <?php foreach (VAST_CACHE_TTLS as $v): ?>
    <option value="<?=$v?>" <?=$cfg['cache_ttl'] === $v ? 'selected' : ''?>><?php if ($v < 120): ?><?=$v?> _(seconds)_<?php else: ?><?=$v / 60?> _(minutes)_<?php endif; ?></option>
    <?php endforeach; ?>
  </select>
